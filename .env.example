# Copy to .env. Use: bugg-source --env .env db-upgrade / platform --workers 1
# Literal values only, no quotes/variable expansion. Process environment takes priority.
# Development facts database; production should use PostgreSQL instead.
BUGG_DATABASE_URL=sqlite:///data/bugg-source.sqlite3
# BUGG_DATABASE_URL=postgresql+psycopg://bugg:CHANGE_ME@127.0.0.1:5432/bugg_source
BUGG_DATA_DIR=./data
BUGG_PUBLIC_URL=http://127.0.0.1:5173
BUGG_API_PORT=18449
# platform automatically wires a separate local cache-ingest credential.
# Separate cache hosts: set the same 32+ character credential at both endpoints.
# BUGG_CACHE_INGEST_TOKEN=
# TRANSLATION_FACTS_URL=https://your-source.example
# TRANSLATION_FACTS_TOKEN=
# Optional separate Bearer access. Blank disables Bearer, not platform cookie login.
BUGG_ADMIN_TOKEN=
BUGG_ALLOWED_HOSTS=cdn.modrinth.com,edge.forgecdn.net,mediafilez.forgecdn.net,media.forgecdn.net
BUGG_MAX_PENDING_JOBS=1000
BUGG_MAX_RUNNING_JOBS=4
BUGG_MAX_DOWNLOAD_BYTES=268435456
BUGG_DAILY_DOWNLOAD_BYTES=21474836480
BUGG_MIN_FREE_DISK_BYTES=536870912

# One hub writer. Its SQLite/FTS5 is NOT the facts PostgreSQL database.
TRANSLATION_HOST=127.0.0.1
TRANSLATION_PORT=18448
TRANSLATION_PUBLIC_URL=http://127.0.0.1:5173
TRANSLATION_DATABASE=./data/platform/translations.sqlite3
TRANSLATION_MIRROR_ROOT=./data/platform/game-mirror
TRANSLATION_MIRROR_PORT=18450
TRANSLATION_TRUSTED_PROXY=false
# Blank bootstrap token enables the existing first-install account wizard.
TRANSLATION_ADMIN_TOKEN=
# No model calls without an explicitly configured endpoint AND key.
TRANSLATION_BASE_URL=
TRANSLATION_API_KEY=
# Optional official CurseForge API credential, never sent to the browser.
TRANSLATION_CURSEFORGE_KEY=

# platform command generates these automatically. Set both only for separate processes.
# BUGG_PLATFORM_AUTH_URL=http://127.0.0.1:18448
# BUGG_PLATFORM_AUTH_TOKEN=replace-with-one-shared-random-internal-secret
# TRANSLATION_ENV_FILE=E:/private/source.env

# Optional evidence archive: explicitly selected profile and external credentials.
# BUGG_CLOUD_PROFILE_FILE=./examples/rainyun-profile.json
# BUGG_CLOUD_PROFILE_ID=rainyun-source
# BUGG_CLOUD_CREDENTIALS_FILE=E:/private/source.credentials.json
# Credentials: {"rainyun-source":{"access_key":"...","secret_key":"..."}}

# Search requires PostgreSQL with vector + pg_trgm; run db-upgrade first.
BUGG_SEARCH_ENABLED=0
# platform fills source/API URLs when using default local topology.
# BUGG_SEARCH_SOURCE_URL=http://127.0.0.1:18448
# BUGG_SEARCH_API_URL=http://127.0.0.1:18449
# Unique per worker/API deployment. All must use the same tokenizer/model revision.
BUGG_NODE_ID=local
# Optional private CPU inference. No implicit model download or model launch.
# BUGG_EMBEDDING_URL=http://127.0.0.1:18452
# BUGG_EMBEDDING_TOKEN=replace-with-independent-random-secret
# BUGG_EMBEDDING_MODEL_DIR=./data/models/bge-small-zh-v1.5
# BUGG_EMBEDDING_REVISION=revision-from-bugg-model-json
BUGG_EMBEDDING_DIMENSIONS=512
# Only for a private HTTPS export gateway; keep disabled on public ingress.
BUGG_SEARCH_ALLOW_REMOTE_EXPORT=0

# Optional remote mirror: an SSH local forward; never expose /_internal/control.
# The hub keeps only mirror_root/control-token, while the mirror owns settings.
# TRANSLATION_MIRROR_CONTROL_PORT=18460

