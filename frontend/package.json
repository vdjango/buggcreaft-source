{
  "name": "bugg-source-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node tools/platform-prerender.mjs",
    "test": "vitest run",
    "visual": "node tools/visual-check.mjs",
    "visual:migration": "node tools/migration-visual.mjs",
    "visual:search": "node tools/search-visual.mjs",
    "methods": "node tools/update-method-index.mjs",
    "methods:check": "node tools/update-method-index.mjs --check"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
